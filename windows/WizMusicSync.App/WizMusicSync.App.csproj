<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- WPF and WinForms share type names; keep usings explicit -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WizMusicSync</AssemblyName>
    <RootNamespace>WizMusicSync.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <Product>WiZ Music Sync</Product>
    <!-- WPF's Windows 11 (Fluent) theme is still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WASAPI loopback capture of whatever the PC is playing -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WizMusicSync.Core\WizMusicSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
